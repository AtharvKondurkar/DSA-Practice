class Solution {
public:
    double myPow(double x, int n) {
        long long exp = n;
        double ans = 1.0;

        if (exp < 0) {
            x = 1.0 / x;
            exp = -exp;
        }

        while (exp > 0) {
            if (exp % 2 == 0) {
                x = x * x;
                exp = exp / 2;
            }
            else {
                ans = ans * x;
                x = x * x;
                exp = (exp - 1) / 2;
            }
        }

        return ans;
    }
};